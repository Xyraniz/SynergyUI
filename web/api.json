  "windowOptions": {
    "Title":"string?; default Synergy Hub",
    "Subtitle":"string?; default nil",
    "Theme":"string|table?; default Dark",
    "AccentColor":"Color3?; default nil",
    "Background|BackgroundAsset":"number|string?; default nil",
    "BackgroundImageTransparency":"number?; default 0.52, clamped 0..1",
    "BackgroundScaleType":"Enum.ScaleType?; default Crop",
    "ToggleKey":"Enum.KeyCode|string?; default RightShift; None disables",
    "Parent":"Instance?; CoreGui or PlayerGui in Studio",
    "ConfigName":"string?; default default_config",
    "Localization":"table?; FallbackLanguage, Language, Translations",
    "Language":"string?; initial global language",
    "IconSet":"false|string|array?; all built-in sets by default",
    "CloseOnEscape":"boolean?; false by default",
    "OnOpen|OnClose|OnDestroy":"function?; called on each corresponding event"
  },
  "windowMethods": {
    "SetToggleKey":{"signature":"Window:SetToggleKey(keyName: string) -> Window","args":"keyName: string","returns":"Window","notes":"Use None to disable. Invalid names leave the existing key unchanged."},
    "OnOpen":{"signature":"Window:OnOpen(callback: function(Window)) -> Window","args":"callback(window)","returns":"Window","notes":"Registers a listener; runs on every real open."},
    "OnClose":{"signature":"Window:OnClose(callback: function(Window)) -> Window","args":"callback(window)","returns":"Window","notes":"Registers a listener; runs on every real close."},
    "OnDestroy":{"signature":"Window:OnDestroy(callback: function(Window)) -> Window","args":"callback(window)","returns":"Window","notes":"Registers a listener for destruction."},
    "IsOpen":{"signature":"Window:IsOpen() -> boolean","args":"none","returns":"boolean"},
    "Open":{"signature":"Window:Open() -> Window","args":"none","returns":"Window"},
    "Close":{"signature":"Window:Close() -> Window","args":"none","returns":"Window"},
    "Toggle":{"signature":"Window:Toggle() -> Window","args":"none","returns":"Window"},
    "RefreshTheme":{"signature":"Window:RefreshTheme() -> nil","args":"none","returns":"nil"},
    "SetTitle":{"signature":"Window:SetTitle(value: string) -> nil","args":"value: string","returns":"nil"},
    "SetSubtitle":{"signature":"Window:SetSubtitle(value: string|nil) -> nil","args":"value: string|nil","returns":"nil"},
    "SetBackground":{"signature":"Window:SetBackground(asset: number|string, transparency: number?) -> boolean","args":"asset: number|string, transparency: number|nil","returns":"boolean"},
    "RefreshLocalization":{"signature":"Window:RefreshLocalization() -> nil","args":"none","returns":"nil"},
    "SetLanguage":{"signature":"Window:SetLanguage(language: string) -> boolean","args":"language: string","returns":"boolean"},
    "Alert":{"signature":"Window:Alert(options: table) -> Dialog","args":"options: table","returns":"Dialog","notes":"Assigns OwnerWindow automatically."},
    "Confirm":{"signature":"Window:Confirm(options: table) -> Dialog","args":"options: table","returns":"Dialog","notes":"Assigns OwnerWindow automatically."},
    "Prompt":{"signature":"Window:Prompt(options: table) -> Dialog","args":"options: table","returns":"Dialog","notes":"Assigns OwnerWindow automatically."},
    "SetAccent":{"signature":"Window:SetAccent(color: Color3) -> nil","args":"color: Color3","returns":"nil"},
    "SetTheme":{"signature":"Window:SetTheme(themeValue: string|table) -> Window","args":"themeValue: string|table","returns":"Window"},
    "Destroy":{"signature":"Window:Destroy() -> Window","args":"none","returns":"Window"},
    "CreateTab":{"signature":"Window:CreateTab(name: string, icon: string|table|nil) -> Elements","args":"name: string, icon: string|table|nil","returns":"Elements"}
  },
  "builders": {
    "CreateSection":{"signature":"Elements:CreateSection(name: string) -> TextLabel","options":["name"],"returns":"TextLabel","defaults":{"name":"required"}},
    "CreateLabel":{"signature":"Elements:CreateLabel(text: string) -> TextLabel","options":["text"],"returns":"TextLabel","defaults":{"text":"required"}},
    "CreateSeparator":{"signature":"Elements:CreateSeparator() -> Frame","options":[],"returns":"Frame"},
    "CreateButton":{"signature":"Elements:CreateButton(options) -> Frame, RBXScriptConnection","options":["Name","Tooltip","Callback"],"returns":"Frame, RBXScriptConnection","defaults":{"Tooltip":null,"Callback":null},"notes":"Callback runs on click under pcall."},
    "CreateToggle":{"signature":"Elements:CreateToggle(options) -> Frame, RBXScriptConnection","options":["Name","Flag","CurrentValue","Callback"],"returns":"Frame, RBXScriptConnection","defaults":{"Flag":"Name","CurrentValue":false,"Callback":null},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"Initial callback only when state is true."},
    "CreateCheckBox":{"signature":"Elements:CreateCheckBox(options) -> Frame, RBXScriptConnection","options":["Name","Flag","CurrentValue","Callback"],"returns":"Frame, RBXScriptConnection","defaults":{"Flag":"Name","CurrentValue":false,"Callback":null},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"Initial callback only when state is true."},
    "CreateSlider":{"signature":"Elements:CreateSlider(options) -> Frame, array<RBXScriptConnection>","options":["Name","Flag","Range","Increment","CurrentValue","Callback"],"returns":"Frame, array<RBXScriptConnection>","defaults":{"Flag":"Name","Increment":1,"CurrentValue":"Range[1]","Callback":null},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"Range is required; saved numeric values are clamped."},
    "CreateProgressBar":{"signature":"Elements:CreateProgressBar(options) -> ProgressFlag","options":["Name","Flag","Range","Min","Max","CurrentValue","Format","ShowPercentage","ShowValue","Callback"],"returns":"ProgressFlag","defaults":{"Name":"@Progress","Flag":"Name or Progress","Range":"0..100","CurrentValue":"minimum","ShowPercentage":false,"ShowValue":true},"flag":"GetValue, GetPercentage, SetValue, SetProgress"},
    "CreateProgress":{"alias":"CreateProgressBar","signature":"Elements:CreateProgress(options) -> ProgressFlag"},
    "CreateDropdown":{"signature":"Elements:CreateDropdown(options) -> DropdownFlag, RBXScriptConnection","options":["Name","Flag","Options","CurrentOption","CurrentSelected","MultiSelect","Searchable","Callback"],"returns":"DropdownFlag, RBXScriptConnection","defaults":{"Flag":"Name","Options":[],"MultiSelect":false,"Searchable":false},"flag":"Window.Flags[Flag]: GetValue, SetValue, AddOption, RemoveOption, ClearOptions, Select","notes":"Single-select uses CurrentOption; multi-select uses CurrentSelected. Saved valid value wins."},
    "CreateChecklist":{"signature":"Elements:CreateChecklist(options) -> ChecklistFlag, RBXScriptConnection","options":["Name","Flag","Options","CurrentSelected","Callback"],"returns":"ChecklistFlag, RBXScriptConnection","defaults":{"Flag":"Name","Options":[],"CurrentSelected":[]},"flag":"Window.Flags[Flag]: GetValue, SetValue, AddOption, RemoveOption","notes":"Callback receives selection map and runs during initial rebuild."},
    "CreateTextInput":{"signature":"Elements:CreateTextInput(options) -> TextFlag, RBXScriptConnection","options":["Name","Flag","CurrentText","Placeholder","Callback"],"returns":"TextFlag, RBXScriptConnection","defaults":{"Flag":"Name","CurrentText":"","Placeholder":""},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"SetValue writes directly without callback or persistence."},
    "CreateNumberInput":{"signature":"Elements:CreateNumberInput(options) -> NumberFlag, RBXScriptConnection","options":["Name","Flag","CurrentValue","Callback"],"returns":"NumberFlag, RBXScriptConnection","defaults":{"Flag":"Name","CurrentValue":0},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"SetValue invokes callback and persists."},
    "CreateKeybind":{"signature":"Elements:CreateKeybind(options) -> KeybindFlag, array<RBXScriptConnection>","options":["Name","Flag","CurrentKeybind","Callback"],"returns":"KeybindFlag, array<RBXScriptConnection>","defaults":{"Flag":"Name","CurrentKeybind":"None"},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"Escape becomes None; capture expires after five seconds. Flag Keybind synchronizes Window.ToggleKey."},
    "CreateColorPicker":{"signature":"Elements:CreateColorPicker(options) -> ColorFlag, RBXScriptConnection","options":["Name","Flag","Color","Callback"],"returns":"ColorFlag, RBXScriptConnection","defaults":{"Flag":"Name","Color":"Color3.fromRGB(0,170,255)"},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"Rainbow stops on Window:Destroy or SetValue."},
    "CreateRadioGroup":{"signature":"Elements:CreateRadioGroup(options) -> RadioFlag, nil","options":["Name","Flag","Options","CurrentValue","Callback"],"returns":"RadioFlag, nil","defaults":{"Flag":"Name","CurrentValue":"first valid option","Callback":null},"flag":"Window.Flags[Flag]: GetValue, SetValue","notes":"Valid CurrentValue wins before saved value; initial selection does not call Callback."},
    "CreateParagraph":{"signature":"Elements:CreateParagraph(options) -> Frame","options":["Title","Content","Image","ImageDescription"],"returns":"Frame","defaults":{"Title":"","Content":"","Image":null,"ImageDescription":null}},
    "CreateImage":{"signature":"Elements:CreateImage(options) -> Frame","options":["Title","Image","Description"],"returns":"Frame","defaults":{"Title":"@Image","Image":"","Description":""}},
    "CreateVideo":{"signature":"Elements:CreateVideo(options) -> Frame","options":["Title","Video","Looped","Volume"],"returns":"Frame","defaults":{"Title":"@Video","Video":"","Looped":false,"Volume":1}}
  },
  "themes": ["Dark","Slate","Ivory","Sage","Burgundy","Sandstone","Ocean"],
  "iconSets": {"craft":1008,"geist":328,"gravity":781,"lucide":1715,"sfsymbols":6984,"solar":7330},
  "persistence": {
    "path":"SynergyUI/Settings/<ConfigName>.json",
    "optionalFunctions":["isfolder","makefolder","isfile","readfile","writefile"],
    "specialKeys":["__size","__minimized","__theme","__position"],
    "valuePriority":"saved valid value, then control-specific current option, then component default; RadioGroup checks valid CurrentValue before saved value"
  }
}
