  "globalMethods": {
    "CreateWindow": {"signature":"SynergyUI:CreateWindow(options: table) -> Window","args":"options: table","returns":"Window","defaults":{"Title":"Synergy Hub","Theme":"Dark","ToggleKey":"Enum.KeyCode.RightShift","ConfigName":"default_config","size":"560x380"}},
    "Notify": {"signature":"SynergyUI:Notify(options: table|string) -> nil","args":"options: table|string","returns":"nil","options":["Message","Type","Duration","Position","TypeColor","Parent","Callback"]},
    "CreateGameNotification": {"signature":"SynergyUI:CreateGameNotification(options: table) -> nil","args":"options: table","returns":"nil","options":["Parent","Image","Title","MiniTitle","Description","YesText","NoText","YesCallback","NoCallback"]},
    "Alert": {"signature":"SynergyUI:Alert(options: table|string) -> Dialog","args":"options: table|string","returns":"Dialog","options":["Title","Content","Description","AccentColor","BackgroundColor","Parent","OwnerWindow","CloseOnOverlay","CloseOnEscape","OkText","ConfirmText","Callback"]},
    "Confirm": {"signature":"SynergyUI:Confirm(options: table|string) -> Dialog","args":"options: table|string","returns":"Dialog","options":["Title","Content","Description","AccentColor","BackgroundColor","Parent","OwnerWindow","CloseOnOverlay","CloseOnEscape","ConfirmText","OkText","CancelText","ConfirmCallback","CancelCallback","Callback"]},
    "Prompt": {"signature":"SynergyUI:Prompt(options: table|string) -> Dialog","args":"options: table|string","returns":"Dialog","options":["Title","Content","Description","AccentColor","BackgroundColor","Parent","OwnerWindow","CloseOnOverlay","CloseOnEscape","ConfirmText","OkText","CancelText","DefaultText","Placeholder","Callback"],"notes":"Cancel button sends nil; overlay or Escape sends false to Callback."},
    "AddTranslations": {"signature":"SynergyUI:AddTranslations(language: string, translations: table) -> boolean","args":"language: string, translations: table","returns":"boolean"},
