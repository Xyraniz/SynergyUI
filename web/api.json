    "Locations": {"signature":"SynergyUI:Locations(config: table) -> boolean","args":"config: table","returns":"boolean","notes":"Alias of Localization"},
    "Localize": {"signature":"SynergyUI.Localize(value: any) -> any","args":"value: any","returns":"localized value"},
    "RegisterTheme": {"signature":"SynergyUI:RegisterTheme(name: string, theme: table) -> boolean","args":"name: string, theme: table","returns":"boolean"},
    "GetThemes": {"signature":"SynergyUI:GetThemes() -> array<string>","args":"none","returns":"sorted array<string>"},
