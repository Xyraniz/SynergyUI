{
  "project": "SynergyUI",
  "version": "repository-main",
  "source": "../dist/main.lua",
  "language": "es",
  "pages": [
    {"path":"index.html","topic":"overview"},
    {"path":"examples.html","topic":"quickstart"},
    {"path":"api.html","topic":"global-api"},
    {"path":"components.html","topic":"components"},
    {"path":"themes.html","topic":"themes"},
    {"path":"icons.html","topic":"icons"},
    {"path":"localization.html","topic":"localization"},
    {"path":"reference.html","topic":"runtime"}
  ],
  "globalMethods": {
    "CreateWindow": {"args":"options: table", "returns":"Window"},
    "Notify": {"args":"options: table|string", "returns":"nil"},
    "CreateGameNotification": {"args":"options: table", "returns":"nil"},
    "Alert": {"args":"options: table|string", "returns":"Dialog"},
    "Confirm": {"args":"options: table|string", "returns":"Dialog"},
    "Prompt": {"args":"options: table|string", "returns":"Dialog"},
    "AddTranslations": {"args":"language: string, translations: table", "returns":"boolean"},
    "SetLanguage": {"args":"language: string", "returns":"boolean"},
    "GetLanguage": {"args":"none", "returns":"string"},
    "GetTranslations": {"args":"none", "returns":"table"},
    "Localization": {"args":"config: table", "returns":"boolean"},
    "Locations": {"args":"config: table", "returns":"boolean; alias of Localization"},
    "Localize": {"args":"value: any", "returns":"localized value"},
    "RegisterTheme": {"args":"name: string, theme: table", "returns":"boolean"},
    "GetThemes": {"args":"none", "returns":"sorted array<string>"},
    "GetTheme": {"args":"name: string", "returns":"normalized cloned theme or nil"}
  },
  "windowMethods": {
    "SetToggleKey":"keyName: string; None disables",
    "OnOpen":"callback(window)",
    "OnClose":"callback(window)",
    "OnDestroy":"callback(window)",
    "IsOpen":"returns boolean",
    "Open":"returns Window",
    "Close":"returns Window",
    "Toggle":"returns Window",
    "RefreshTheme":"returns nil",
    "SetTitle":"value: string",
    "SetSubtitle":"value: string|nil",
    "SetBackground":"asset: number|string, transparency: number|nil; returns boolean",
    "RefreshLocalization":"returns nil",
    "SetLanguage":"language: string",
    "Alert":"options: table; assigns OwnerWindow",
    "Confirm":"options: table; assigns OwnerWindow",
    "Prompt":"options: table; assigns OwnerWindow",
    "SetAccent":"color: Color3",
    "SetTheme":"themeValue: string|table; returns Window",
    "Destroy":"returns Window",
    "CreateTab":"name: string, icon: string|table|nil; returns Elements"
  },
  "builders": {
    "CreateSection":{"options":["name"],"returns":"TextLabel"},
    "CreateLabel":{"options":["text"],"returns":"TextLabel"},
    "CreateSeparator":{"options":[],"returns":"Frame"},
    "CreateButton":{"options":["Name","Tooltip","Callback"],"returns":"Frame, Connection"},
    "CreateToggle":{"options":["Name","Flag","CurrentValue","Callback"],"returns":"Frame, Connection","flag":"GetValue, SetValue"},
    "CreateCheckBox":{"options":["Name","Flag","CurrentValue","Callback"],"returns":"Frame, Connection","flag":"GetValue, SetValue"},
    "CreateSlider":{"options":["Name","Flag","Range","Increment","CurrentValue","Callback"],"returns":"Frame, connections","flag":"GetValue, SetValue"},
    "CreateProgressBar":{"options":["Name","Flag","Range","Min","Max","CurrentValue","Format","ShowPercentage","ShowValue","Callback"],"returns":"flag object","flag":"GetValue, GetPercentage, SetValue, SetProgress"},
    "CreateProgress":{"alias":"CreateProgressBar"},
    "CreateDropdown":{"options":["Name","Flag","Options","CurrentOption","CurrentSelected","MultiSelect","Searchable","Callback"],"returns":"flag object, Connection","flag":"GetValue, SetValue, AddOption, RemoveOption, ClearOptions, Select"},
    "CreateChecklist":{"options":["Name","Flag","Options","CurrentSelected","Callback"],"returns":"flag object, Connection","flag":"GetValue, SetValue, AddOption, RemoveOption"},
    "CreateTextInput":{"options":["Name","Flag","CurrentText","Placeholder","Callback"],"returns":"flag object, Connection","flag":"GetValue, SetValue"},
    "CreateNumberInput":{"options":["Name","Flag","CurrentValue","Callback"],"returns":"flag object, Connection","flag":"GetValue, SetValue"},
    "CreateKeybind":{"options":["Name","Flag","CurrentKeybind","Callback"],"returns":"flag object, connections","flag":"GetValue, SetValue"},
    "CreateColorPicker":{"options":["Name","Flag","Color","Callback"],"returns":"flag object, Connection","flag":"GetValue, SetValue"},
    "CreateRadioGroup":{"options":["Name","Flag","Options","CurrentValue","Callback"],"returns":"flag object, nil","flag":"GetValue, SetValue"},
    "CreateParagraph":{"options":["Title","Content","Image","ImageDescription"],"returns":"Frame"},
    "CreateImage":{"options":["Title","Image","Description"],"returns":"Frame"},
    "CreateVideo":{"options":["Title","Video","Looped","Volume"],"returns":"Frame"}
  },
  "themes": ["Rise","Dark","Cyberpunk","TokyoNight","Red","BloodRed","White","Ubuntu","Glacier","Midnight","Anime","Femboy","Hanki","Ocean","Forest","Sunset"],
  "iconSets": {"craft":1008,"geist":328,"gravity":781,"lucide":1715,"sfsymbols":6984,"solar":7330},
  "persistence": {
    "path":"SynergyUI/Settings/<ConfigName>.json",
    "optionalFunctions":["isfolder","makefolder","isfile","readfile","writefile"],
    "specialKeys":["__size","__minimized","__theme","__position"]
  }
}
